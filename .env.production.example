# Generate real values with scripts/deploy.py init; this file is documentation only.
LABFLOW_DOMAIN=labflow.your-domain.example
ACME_EMAIL=you@your-domain.example
LABFLOW_RELEASE=replace-with-git-commit
POSTGRES_PASSWORD=replace-with-random-secret
RABBITMQ_PASSWORD=replace-with-random-secret
AUTH_JWT_SECRET=replace-with-random-secret
WORKER_SERVICE_TOKEN=replace-with-random-secret
WORKER_IMAGE_DIGEST=replace-with-built-image-id

# Expired-attempt recovery (five-second scans, up to 50 attempts per transaction)
RECOVERY_REAPER_ENABLED=true
RECOVERY_REAPER_FIXED_DELAY=PT5S
RECOVERY_REAPER_INITIAL_DELAY=PT5S
RECOVERY_BATCH_SIZE=50
